PORT=3000
NODE_ENV=development

# openssl rand -hex 32
WALLET_SERVICE_API_KEY=dev-only-replace-with-32-plus-chars

# Placeholders so the process can boot without PEMs.
# Generate still returns 503 until real certs are configured.
APPLE_TEAM_IDENTIFIER=ABCDE12345
APPLE_PASS_TYPE_IDENTIFIER=pass.com.hackuta.2026

EVENT_NAME=HackUTA 2026
EVENT_LOCATION=The University of Texas at Arlington
EVENT_START_DATE=2026-11-14T09:00:00-06:00
EVENT_END_DATE=2026-11-15T18:00:00-06:00
