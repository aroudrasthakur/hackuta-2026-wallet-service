PORT=3000
NODE_ENV=production

# Generate with: openssl rand -hex 32
# The same value must be set on Convex as WALLET_SERVICE_API_KEY.
WALLET_SERVICE_API_KEY=

# From Apple Developer → Membership details / Identifiers
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_TYPE_IDENTIFIER=pass.com.hackuta.2026

# Docker Compose mounts ./certs at /certs (use these paths in compose).
# For local `npm start` / `npm run dev`, use ./certs/signerCert.pem instead.
APPLE_CERT_PATH=/certs/signerCert.pem
APPLE_KEY_PATH=/certs/signerKey.pem
APPLE_KEY_PASSPHRASE=
APPLE_WWDR_PATH=/certs/wwdr.pem

EVENT_NAME=HackUTA 2026
EVENT_LOCATION=The University of Texas at Arlington
EVENT_START_DATE=2026-11-14T09:00:00-06:00
EVENT_END_DATE=2026-11-15T18:00:00-06:00
